#!/bin/bash

# Same steps as the Windows "Build and Run Bochs" task, but inside Docker:
#   1. rm -rf obj/* && make -j$(nproc) all           (full clean rebuild)
#   2. bochs -q                                       (uses ./.bochsrc)
#
#   ./run             Browser mode: opens http://localhost:6080
#   ./run term        Terminal mode: text screen inside this terminal
#   NOCLEAN=1 ./run   Skip the clean rebuild (faster, only runs make)
#
# Stop with Ctrl+C.

cd "$(dirname "$0")"

MODE="${1:-web}"

# Dynamically determine available CPU cores for Linux or macOS
if command -v nproc >/dev/null 2>&1; then
    NCPUS="$(nproc)"
else
    NCPUS="$(sysctl -n hw.ncpu 2>/dev/null || echo 8)"
fi

if [ -n "$NOCLEAN" ]; then
    BUILD="make -j${NCPUS} all"
else
    # Clear contents without deleting the mounted tmpfs 'obj' folder
    BUILD="rm -rf obj/* && make -j${NCPUS} all"
fi

if [ ! -f .bochsrc ]; then
    echo "[!] .bochsrc not found in the project root."
    exit 1
fi
echo "[*] Using the project's Bochs config: .bochsrc"

if [ "$MODE" = "term" ]; then
    echo "[*] Terminal mode. To quit: Ctrl+C, then type q and press Enter."
    docker run --rm -it \
        --cpus="${NCPUS}" \
        -v "$PWD":/fos \
        --mount type=tmpfs,destination=/fos/obj \
        fos-env bash -c "
$BUILD || exit 1
echo c > /tmp/bochs.rc
bochs -rc /tmp/bochs.rc -q 'display_library: term' \
    'sound: waveoutdrv=dummy, waveindrv=dummy, midioutdrv=dummy'
"
    exit
fi

# Every run serves noVNC from a brand-new URL path, so the browser has no
# cached copy of vnc.html or its JS modules to fall back on. This means no
# Ctrl+Shift+R (hard reload) is ever needed, and HTML/JS from different noVNC
# releases can never be mixed.
RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
URL="http://localhost:6080/$RUN_ID/vnc.html?autoconnect=true&resize=scale"
echo "[*] Browser mode: $URL"

# Open the browser as soon as the web server inside the container is up
(
    for i in $(seq 1 300); do
        if curl -s -o /dev/null "http://localhost:6080/$RUN_ID/vnc.html"; then
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$URL" >/dev/null 2>&1 || true
            elif command -v open >/dev/null 2>&1; then
                open "$URL" >/dev/null 2>&1 || true
            else
                echo "[*] Open this in your browser: $URL"
            fi
            break
        fi
        sleep 1
    done
) &

docker run --rm -it \
    --cpus="${NCPUS}" \
    -p 127.0.0.1:6080:6080 \
    -v "$PWD":/fos \
    --mount type=tmpfs,destination=/fos/obj \
    fos-env bash -c "
$BUILD || exit 1
# Serve this run's noVNC from its own path, so the browser cannot reuse
# cached files from a previous run.
mkdir -p /tmp/novnc-runs
rm -rf /tmp/novnc-runs/$RUN_ID
cp -a /usr/share/novnc /tmp/novnc-runs/$RUN_ID
export DISPLAY=:99
Xvfb :99 -screen 0 1024x768x24 >/dev/null 2>&1 &
sleep 1
x11vnc -display :99 -forever -shared -nopw -quiet >/dev/null 2>&1 &
websockify --web /tmp/novnc-runs 6080 localhost:5900 >/dev/null 2>&1 &
echo c > /tmp/bochs.rc
bochs -rc /tmp/bochs.rc -q 'display_library: x' \
    'sound: waveoutdrv=dummy, waveindrv=dummy, midioutdrv=dummy'
"
